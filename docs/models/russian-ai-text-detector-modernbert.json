      {
        "pattern": "(?<!\\w)_+|_+(?!\\w)",
        "replacement": "",
        "why": "подчёркивания разметки на краях слов"
      },
      {
        "pattern": "\\|",
        "replacement": " ",
        "why": "столбцы таблиц"
