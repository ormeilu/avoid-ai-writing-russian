{
  "name": "avoid-ai-writing-russian",
  "version": "0.1.0",
  "description": "Детектор и валидатор ИИ-стиля в русских текстах: канцелярит, кальки, шаблонная структура, оценка в духе модуля ИИ-детекции Антиплагиата.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Ilya Lubenets",
    "email": "lubenets.ilya.igorevich@gmail.com",
    "url": "https://github.com/ormeilu"
  },
  "homepage": "https://github.com/ormeilu/avoid-ai-writing-russian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ormeilu/avoid-ai-writing-russian.git"
  },
  "keywords": [
    "russian",
    "русский язык",
    "writing",
    "editing",
    "style",
    "ai-detection",
    "ai-writing",
    "humanize",
    "antiplagiat",
    "антиплагиат",
    "канцелярит",
    "kantselyarit",
    "calques",
    "typography",
    "academic",
    "vak",
    "claude-code",
    "codex",
    "agent-skills",
    "bun",
    "typescript"
  ],
  "module": "src/index.ts",
  "bin": {
    "aiw-ru": "src/cli.ts"
  },
  "files": [
    "src",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "selfscan": "bun src/cli.ts scan README.md CONTRIBUTING.md AGENTS.md CLAUDE.md NOTICE.md CHANGELOG.md skills/avoid-ai-writing-russian/SKILL.md skills/avoid-ai-writing-russian/references/patterns.md skills/antiplagiat/SKILL.md --context docs --min P1 --fail-above 30",
    "build": "bun build src/cli.ts --compile --minify --outfile dist/aiw-ru",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun test && bun run selfscan && bun scripts/check-versions.ts",
    "release": "bun scripts/release.ts",
    "eval": "bun evals/run.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "contributors": [
    {
      "name": "Conor Bronsdon",
      "url": "https://github.com/conorbronsdon"
    }
  ],
  "bugs": {
    "url": "https://github.com/ormeilu/avoid-ai-writing-russian/issues"
  },
  "private": false
}
